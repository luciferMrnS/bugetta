# Copy to .env and adjust for your environment.
#
# Local development (SQLite — zero-install database file):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/dev.db"

# Production (Supabase / PostgreSQL). Create a project on supabase.com, go to
# Settings → Database, and copy the "pooled" connection string. Uncomment both
# lines below and paste the URL:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Render production WITHOUT Supabase: keep SQLite on a persistent disk so data
# survives redeploys. In Render, create a persistent disk mounted at /var/data
# and use an absolute path (below). Set the release/start command to:
#   npx prisma migrate deploy && npm start
# so migrations run against the mounted disk at boot.
# DATABASE_URL="file:/var/data/bugetta.db"

# Next.js runtime (set only when needed, e.g. when using non-localhost hosts):
# HOSTNAME="0.0.0.0"
# PORT="3000"

# Email verification. Resend (https://resend.com) is the recommended sender:
# create an API key and paste it in place of RE_API_KEY. Until a domain is
# verified in Resend, keep the onboarding@resend.dev From address (test mode).
# SMTP_URL="smtp://resend:RE_API_KEY@smtp.resend.com:587"
# EMAIL_FROM="Bugetta <onboarding@resend.dev>"
# With a verified domain (e.g. bugetta.app):
# EMAIL_FROM="Bugetta <no-reply@bugetta.app>"
#
# Without SMTP_URL, verification links are printed to the terminal in
# development and dropped in tests.

# Optional one-shot admin bootstrap. Set these ONLY in your private .env —
# never commit the values. Register with the exact email below and type the
# code into the "admin invite code" field on the registration form; that
# account is created as ADMIN (giving it the full Operations + Admin areas).
# The gate is first-admin-wins: it self-disables as soon as any ADMIN exists,
# so a leaked email/code can never promote a second account.
# ADMIN_BOOTSTRAP_EMAIL="you@example.com"
# ADMIN_BOOTSTRAP_CODE="replace-with-a-long-random-string"